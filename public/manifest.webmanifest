{
  "name": "Pocket Desktop",
  "short_name": "Pocket Desk",
  "description": "See, control and play on your Ubuntu PC from your phone \u2014 remote screen, virtual gamepad and air mouse.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen"
  ],
  "orientation": "any",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "categories": [
    "utilities",
    "productivity",
    "games"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Gamepad",
      "short_name": "Gamepad",
      "description": "Full-screen controller",
      "url": "/?go=pad"
    },
    {
      "name": "Open remote screen",
      "short_name": "Remote",
      "url": "/?go=remote"
    },
    {
      "name": "Screenshot",
      "short_name": "Shot",
      "url": "/?go=shot"
    }
  ],
  "id": "pocket-desktop"
}
